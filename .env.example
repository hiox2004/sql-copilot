# Copy to .env and change the passwords.
POSTGRES_DB=saas
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me_admin
POSTGRES_PORT=5432
# Optional pgAdmin (database browser), started with --profile tools
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me_pgadmin
# Read-only role used by the copilot at run time
COPILOT_RO_USER=copilot_ro
COPILOT_RO_PASSWORD=change_me_readonly
